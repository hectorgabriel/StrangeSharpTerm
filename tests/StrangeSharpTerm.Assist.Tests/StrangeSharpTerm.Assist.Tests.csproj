<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>StrangeSharpTerm.Assist.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Recorded streams, byte for byte as a provider sent them. Copied rather
      than embedded so that a new one can be added by dropping a file in.
    -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/StrangeSharpTerm.Assist/StrangeSharpTerm.Assist.csproj" />
  </ItemGroup>
</Project>
