<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        How the shell is painted. Every colour is a DynamicResource from
        ThemeTokens, so switching themes rewrites the dictionary and the window
        follows without anything being rebuilt.

        Fluent's own control themes are left in place and overridden here rather
        than replaced: a style setter outranks a control theme, including in a
        pseudo-class state, so a hover no longer flashes Fluent's grey over a
        Dracula sidebar.
    -->

    <!--
        Lucide is a stroke system: 24x24, two units wide, round caps and
        joins. Setting it here once keeps every call site to a Data binding,
        and keeps an icon from being drawn filled by accident.
    -->
    <Style Selector="Path.icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- A label, a hostname, a caption: said, and not shouted. -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- A section header in a form: small, spaced, and quiet. -->
    <Style Selector="TextBlock.section">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1" />
    </Style>

    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Colour comes from Fluent's own keys (see ThemeTokens.Fluent); what a
         style can still set is what the theme leaves to the control. -->
    <Style Selector="TextBox">
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- A row in the sidebar or the tab strip: nothing until it is pointed at. -->
    <Style Selector="Button.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- The selected host stays marked while the pointer is elsewhere. Set on
         the control, not the template part: the part belongs to Fluent's theme. -->
    <Style Selector="Button.row.selected">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>

    <!-- A tab: the focused one is lit the way the selected host is. -->
    <Style Selector="Border.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Border.tab.active">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>

    <!-- An ordinary button needs no style at all: Fluent's own keys are pointed
         at this theme (ThemeTokens.Fluent). Setting Background here would also
         outrank the primary button's control theme, which is how the accent one
         came out grey. -->

    <!-- A chip: a tag, a count, a status. -->
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- A pane in a split tab. Outlined when the keyboard is in it. -->
    <Style Selector="Border.pane">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.pane.active">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- The divider between two panes: the background between them until it is
         pointed at, and the accent while it is being dragged. -->
    <Style Selector="GridSplitter.pane">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    </Style>

    <Style Selector="GridSplitter.pane:pointerover">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>

    <!-- Something that went wrong, said where the user was looking. -->
    <Style Selector="Border.banner">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
</Styles>
