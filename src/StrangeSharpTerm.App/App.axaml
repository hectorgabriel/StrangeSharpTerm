<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StrangeSharpTerm.App.App"
             RequestedThemeVariant="Dark">
    <!--
        Dark, not "Default": both themes are dark (docs/adr/0004), so following
        the system variant would light Fluent's controls while every surface
        around them stayed near-black.
    -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://StrangeSharpTerm/Icons/Icons.axaml" />
                <ResourceInclude Source="avares://StrangeSharpTerm/Icons/ColorIcons.axaml" />
                <ResourceInclude Source="avares://StrangeSharpTerm/Styles/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!--
            The terminal control's template. The control adds this itself, once,
            from its static constructor, and only if an Application exists by
            then; when it does not, every terminal is an empty box. Named here it
            cannot miss, and the control sees it and adds no second copy. First,
            where the control would have put it.
        -->
        <StyleInclude Source="avares://Iciclecreek.Avalonia.Terminal/Themes/Generic.axaml" />
        <FluentTheme />
        <StyleInclude Source="avares://StrangeSharpTerm/Styles/Chrome.axaml" />
    </Application.Styles>
</Application>
