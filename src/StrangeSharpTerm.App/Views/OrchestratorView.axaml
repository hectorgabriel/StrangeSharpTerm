<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
             xmlns:views="clr-namespace:StrangeSharpTerm.App.Views"
             xmlns:assist="clr-namespace:StrangeSharpTerm.Assist;assembly=StrangeSharpTerm.Assist"
             x:Class="StrangeSharpTerm.App.Views.OrchestratorView"
             x:DataType="vm:OrchestratorViewModel">
    <UserControl.Resources>
        <!--
            One host's exchange: what it was asked, what it was working out, every
            command it ran with what came back, and what it answered. Defined once
            and used by both lists, because a fan-out row and a phase row are the
            same thing seen from different sides.

            Read-only, deliberately. The gate lives in the orchestrator, where one
            person answers for the whole run; a second set of approve buttons per
            host would be two gates for one decision.
        -->
        <DataTemplate x:Key="Exchange" x:DataType="vm:FindingRow">
            <StackPanel Margin="0,6,0,0" Spacing="4" IsVisible="{Binding HasExchange}">
                <Button Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalAlignment="Left" Command="{Binding ToggleExchangeCommand}">
                    <TextBlock Classes="muted" FontSize="10" Text="{Binding ExchangeToggle}" />
                </Button>

                <ItemsControl ItemsSource="{Binding Exchange}" IsVisible="{Binding IsExchangeOpen}"
                              Margin="8,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssistRow">
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                           IsVisible="{Binding IsQuestion}" Text="{Binding Text}" />

                                <TextBlock Classes="muted" FontSize="10" FontStyle="Italic"
                                           TextWrapping="Wrap" IsVisible="{Binding HasReasoning}"
                                           Text="{Binding Reasoning}" />

                                <!-- A command is a row in the same list as the answer,
                                     deliberately: what it actually ran should never
                                     require looking somewhere else. -->
                                <StackPanel IsVisible="{Binding IsStep}" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontFamily="monospace" FontSize="10"
                                                   TextWrapping="Wrap" Text="{Binding Command}" />
                                        <TextBlock Classes="muted" FontSize="10" Text="{Binding State}" />
                                    </StackPanel>
                                    <SelectableTextBlock Classes="muted" FontFamily="monospace" FontSize="10"
                                               TextWrapping="Wrap" IsVisible="{Binding HasOutput}"
                                               Text="{Binding Output}" />
                                </StackPanel>

                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           IsVisible="{Binding IsAnswer}" Text="{Binding Text}" />

                                <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                           IsVisible="{Binding IsNote}" Text="{Binding Text}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        One instruction across several hosts, and the plan mode beside it.

        Every host is listed with its own status and findings above the collated
        answer. A summary that reads as though it covered ten hosts when three
        were unreachable is the failure this layout exists to prevent, so a host
        that failed or was skipped says so in that list.

        A plan appears in full: every phase, its hosts, and the words each host
        will be given. Summarising it into "3 phases, 4 hosts" would be a plan
        nobody could review, and review is the only thing standing between a
        model and a fleet.
    -->
    <UserControl.Resources>
        <views:IconConverter x:Key="Icon" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Background="{DynamicResource BackgroundBrush}">

        <!--
            Two rows rather than one. This pane lives in a dock now, and three
            things that each want a line of their own (what it is, how the run
            is going, and which provider is answering) do not fit across 380
            points: the progress ran straight through the model's name and both
            became unreadable.

            Which provider is answering decides where this window's terminal
            output is being sent, so it keeps its place rather than being the
            thing that gets dropped.
        -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*"
              Margin="12,10,10,8">
            <Path Grid.Row="0" Grid.Column="0" Classes="icon" Width="14" Height="14" Margin="0,0,8,0"
                  VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}"
                  Data="{Binding Source=IconLayers, Converter={StaticResource Icon}}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Orchestrator" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="muted" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding Progress}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" FontSize="11"
                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                       Text="{Binding Answering}" />
        </Grid>

        <!-- Follows the run as hosts report, and lets go as soon as you scroll
             up to read one of them. -->
        <ScrollViewer Grid.Row="1" views:Follows.TheEnd="True">
            <StackPanel Margin="12,0,12,8" Spacing="8">

                <TextBlock Classes="danger" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding Refusal, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding Refusal}" />

                <!-- The question the findings below are answers to. -->
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,4"
                           IsVisible="{Binding Asked.Length}" Text="{Binding Asked}" />

                <!-- Says the next instruction will be read against the last plan
                     rather than cold, which the screen cannot otherwise show:
                     it holds one plan at a time. -->
                <TextBlock Classes="muted" FontSize="11" IsVisible="{Binding IsContinuing}"
                           Text="{Binding Continuing}" />

                <!-- What the model was working out, where the provider offers it.
                     Above the answer rather than below it: while there is nothing
                     else on screen it is the only sign anything is happening, and
                     afterwards it is the reason the plan says what it says. -->
                <Border Classes="chip" Padding="12,10" CornerRadius="6" IsVisible="{Binding HasThinking}">
                    <StackPanel Spacing="6">
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Left" Command="{Binding ToggleThinkingCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="section" Text="THINKING" />
                                <TextBlock Classes="muted" FontSize="11" Text="{Binding ThinkingToggle}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding IsThinkingOpen}" Text="{Binding Thinking}" />
                    </StackPanel>
                </Border>

                <!-- Ask: one row per host, then the collated answer. -->
                <ItemsControl ItemsSource="{Binding Findings}" IsVisible="{Binding IsAsking}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FindingRow">
                            <Border Classes="chip" Padding="12,10" CornerRadius="6" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Alias}"
                                               FontWeight="SemiBold" />
                                    <!-- The one word that says what became of this
                                         host, in the colour that says it too. -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="muted" FontSize="11"
                                               Classes.danger="{Binding Failed}"
                                               Classes.warning="{Binding Stopped}"
                                               Text="{Binding Label}" />
                                    <SelectableTextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                               TextWrapping="Wrap" FontSize="12" Text="{Binding Text}"
                                               IsVisible="{Binding Reported}" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Classes="muted"
                                               TextWrapping="Wrap" FontSize="12" Text="{Binding Text}"
                                               IsVisible="{Binding !Reported}" />
                                    <ContentControl Grid.Row="2" Grid.ColumnSpan="2" Content="{Binding}"
                                                    ContentTemplate="{StaticResource Exchange}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="chip" Padding="14,12" CornerRadius="6"
                        IsVisible="{Binding Collated.Length}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="ACROSS ALL HOSTS" />
                        <!-- Commands here are shown but never staged: they apply to
                             hosts, plural, and picking one terminal would be
                             picking the wrong one. So no StageCommand, but they
                             are still copyable, which is what a person does with
                             a command meant for several servers. -->
                        <views:MarkdownView Text="{Binding Collated}" />
                    </StackPanel>
                </Border>

                <!-- Plan: every phase in full, each switchable. -->
                <StackPanel Spacing="6" IsVisible="{Binding IsPlanning}">
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasPlan}"
                               Text="Nothing has run. Read it, switch off anything you do not want, then run it." />

                    <ItemsControl ItemsSource="{Binding Phases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhaseRow">
                                <Border Classes="chip" Padding="12,10" CornerRadius="6" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox Grid.Row="0" Grid.Column="0" Margin="0,0,6,0"
                                                  VerticalAlignment="Top" IsChecked="{Binding IsEnabled}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="muted" Margin="0,0,8,0"
                                                   Text="{Binding Number}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Name}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Classes="muted" FontSize="11"
                                                   Text="{Binding Hosts}" />

                                        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                                    Margin="0,4,0,0" Spacing="6">
                                            <!-- Why this phase is on these hosts. Where a choice was
                                                 the planner's to make, this is the only place it
                                                 says so. -->
                                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                                       IsVisible="{Binding Explains}" Text="{Binding Why}" />

                                            <!-- The commands, as they will be sent. Monospaced and
                                                 unwrapped-per-line because a reviewer is reading
                                                 shell, and a rewrapped command is a different one. -->
                                            <Border Padding="8" CornerRadius="4"
                                                    Background="{DynamicResource BackgroundBrush}">
                                                <SelectableTextBlock FontFamily="monospace" FontSize="11"
                                                           TextWrapping="Wrap" Text="{Binding Commands}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                            <TextBlock Classes="muted" FontSize="11" IsVisible="{Binding Yields}"
                                                       Text="{Binding YieldsWhat}" />
                                            <TextBlock Classes="muted" FontSize="11" IsVisible="{Binding Uses}"
                                                       Text="{Binding UsesWhat}" />
                                            <TextBlock Classes="muted" FontSize="11" Text="{Binding Outcome}" />
                                        </StackPanel>

                                        <!-- A captured value is shown verbatim where it was
                                             produced: it is the one thing in the run the user
                                             neither wrote nor read before a machine acted on it. -->
                                        <Border Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                                Padding="8" CornerRadius="4"
                                                Background="{DynamicResource BackgroundBrush}"
                                                IsVisible="{Binding Captured, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="muted" FontSize="10" Text="{Binding CapturedLabel}" />
                                                <SelectableTextBlock FontFamily="monospace" FontSize="11" TextWrapping="Wrap"
                                                           Text="{Binding Captured}" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                                    Spacing="4">
                                            <TextBlock Classes="warning" FontSize="11" TextWrapping="Wrap"
                                                       Text="{Binding Note}"
                                                       IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <ItemsControl ItemsSource="{Binding Findings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:FindingRow">
                                                        <StackPanel Margin="0,2,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                           Text="{Binding Alias}" />
                                                                <TextBlock Classes="muted" FontSize="11"
                                                                           Classes.danger="{Binding Failed}"
                                                                           Classes.warning="{Binding Stopped}"
                                                                           Text="{Binding Label}" />
                                                            </StackPanel>
                                                            <TextBlock Classes="muted" FontSize="11"
                                                                       TextWrapping="Wrap" Text="{Binding Text}" />
                                                            <ContentControl Content="{Binding}"
                                                                            ContentTemplate="{StaticResource Exchange}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- A command waiting on a person, named with its host. Approving
             "systemctl restart nginx" means nothing until you know whose. -->
        <!-- The pending command is the DataContext of the whole banner rather
             than the head of three binding paths: with nothing waiting, one null
             DataContext is silent where three null paths each log an error, and
             a binding that logs when nothing is wrong is a binding nobody reads. -->
        <Border Grid.Row="2" Classes="banner" Margin="12,0,12,8" Padding="12,10"
                DataContext="{Binding Waiting}"
                Classes.caution="{Binding !IsDestructive}"
                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                  x:DataType="assist:PendingCommand">
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="{Binding Host}" />
                    <!-- How many hosts are queued behind this one. Answering
                         what is in front of you without knowing two more are
                         coming is how the third gets clicked through. -->
                    <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                               Text="{Binding $parent[UserControl].((vm:OrchestratorViewModel)DataContext).WaitingMore}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="monospace" FontSize="12"
                           TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding Command}" />
                <!-- Why you are being asked, in the colour of what it would do.
                     The assistant pane has always drawn this distinction; the
                     pane that asks on behalf of several hosts did not. -->
                <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11" TextWrapping="Wrap"
                           Margin="0,2,0,0" Text="{Binding Reason}"
                           Classes.warning="{Binding !IsDestructive}"
                           Classes.danger="{Binding IsDestructive}" />

                <Button Grid.Row="1" Grid.Column="1" Padding="12,4" Margin="8,0,6,0"
                        Command="{Binding $parent[UserControl].((vm:OrchestratorViewModel)DataContext).AllowCommand}">
                    <TextBlock Text="Run it" FontSize="12" />
                </Button>
                <Button Grid.Row="1" Grid.Column="2" Padding="12,4"
                        Command="{Binding $parent[UserControl].((vm:OrchestratorViewModel)DataContext).RefuseCommand}">
                    <TextBlock Text="No" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- Which hosts. Disconnected ones stay tickable and are reported as not asked. -->
        <!-- A connected tool's call, waiting on a person. The server, the tool,
             where it goes and the exact arguments are all here rather than
             behind a disclosure: a gate whose substance is one click away is a
             gate people approve without reading. -->
        <Border Grid.Row="3" Classes="banner" Margin="12,0,12,8" Padding="12,10"
                DataContext="{Binding WaitingTool}"
                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  x:DataType="assist:PendingToolCall">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Server}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding Tool}" FontFamily="monospace" FontSize="12" />
                    <!-- The server's own claim. Shown, and never acted on. -->
                    <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                               Text="the server calls this read-only" IsVisible="{Binding ReadOnlyClaim}" />
                    <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                               Text="{Binding $parent[UserControl].((vm:OrchestratorViewModel)DataContext).WaitingMore}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Classes="muted" FontSize="11" Margin="0,2,0,0"
                           Text="{Binding Destination, StringFormat='Its arguments go to {0}'}" />

                <Border Grid.Row="2" Margin="0,6,0,0" Padding="8" CornerRadius="4"
                        Background="{DynamicResource BackgroundBrush}">
                    <ScrollViewer MaxHeight="160">
                        <TextBlock FontFamily="monospace" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding Arguments}" />
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Padding="12,4"
                            Command="{Binding $parent[UserControl].((vm:OrchestratorViewModel)DataContext).AllowCommand}">
                        <TextBlock Text="Run it" FontSize="12" />
                    </Button>
                    <Button Padding="12,4"
                            Command="{Binding $parent[UserControl].((vm:OrchestratorViewModel)DataContext).RefuseCommand}">
                        <TextBlock Text="No" FontSize="12" />
                    </Button>
                    <!-- The only way a standing pass is ever granted, and never
                         offered for a tool the server calls destructive. -->
                    <Button Padding="12,4" IsVisible="{Binding MayBeGranted}"
                            Command="{Binding $parent[UserControl].((vm:OrchestratorViewModel)DataContext).AlwaysAllowCommand}">
                        <TextBlock Text="Always allow" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Expander Grid.Row="4" Margin="12,0,12,6" Padding="0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Hosts" FontSize="12" />
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding ChosenNote}" />
                </StackPanel>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Targets}" Margin="4,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TargetRow">
                        <Border Classes="chip" Padding="10,6" CornerRadius="4" Margin="0,0,6,6" MinWidth="160">
                            <CheckBox IsChecked="{Binding IsChosen}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Alias}" FontSize="12" />
                                    <TextBlock Classes="muted" FontSize="10" VerticalAlignment="Center"
                                               Text="not connected" IsVisible="{Binding !IsConnected}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="12,0,12,6">
            <!-- Which mode is in use is said by the button, not only by the note
                 beside it: the two do very different things to a fleet. -->
            <Button Classes="row" Classes.selected="{Binding IsAsking}" Padding="10,3"
                    Command="{Binding ChooseCommand}"
                    CommandParameter="{x:Static vm:OrchestratorMode.Ask}">
                <TextBlock Text="Ask" FontSize="12" />
            </Button>
            <Button Classes="row" Classes.selected="{Binding IsPlanning}" Padding="10,3"
                    Command="{Binding ChooseCommand}"
                    CommandParameter="{x:Static vm:OrchestratorMode.Plan}">
                <TextBlock Text="Plan" FontSize="12" />
            </Button>
            <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Text="{Binding ModeNote}" />
            <CheckBox VerticalAlignment="Center" IsChecked="{Binding MayRunCommands}">
                <TextBlock Text="Run commands" FontSize="12" />
            </CheckBox>
        </StackPanel>

        <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,0,12,12">
            <!-- Return runs it here too. It did not before: the pane that
                 reaches every host at once was the one you had to click. -->
            <TextBox Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="32" MaxHeight="160" VerticalContentAlignment="Center"
                     Text="{Binding Instruction}" KeyDown="Typed"
                     Watermark="Ask every selected host…" IsVisible="{Binding IsAsking}" />
            <TextBox Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="32" MaxHeight="160" VerticalContentAlignment="Center"
                     Text="{Binding Instruction}" KeyDown="Typed"
                     Watermark="What should be done across these hosts?" IsVisible="{Binding IsPlanning}" />

            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Command="{Binding DiscardCommand}"
                    IsVisible="{Binding HasPlan}">
                <TextBlock Text="Discard" />
            </Button>
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="12,6"
                    Theme="{StaticResource PrimaryButton}"
                    IsVisible="{Binding !IsRunning}" Command="{Binding RunCommand}">
                <TextBlock Text="{Binding RunLabel}" />
            </Button>
            <Button Grid.Column="3" Margin="8,0,0,0" Padding="12,6"
                    IsVisible="{Binding IsRunning}" Command="{Binding StopCommand}">
                <TextBlock Text="Stop" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
