<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
             xmlns:views="clr-namespace:StrangeSharpTerm.App.Views"
             x:Class="StrangeSharpTerm.App.Views.WorkspaceView"
             x:DataType="vm:HostWorkspaceViewModel">
    <!--
        A folder on a server, open: the tree down the left, the files being
        edited on the right, and one connection under both. It is a pane like any
        other — it belongs to a host, sits in a tab, and splits beside the shell
        on the same machine, which is most of the point: the terminal that runs
        the thing is next to the file that configures it.

        Both halves are controls of their own, because this machine's files use
        them apart: the tree goes in the sidebar, where 260 pixels is plenty for
        names and nowhere near enough for a line of code, and the editor goes in
        a pane in the middle. Composing them here is what keeps a host's folder
        looking and working exactly as it did.
    -->
    <Grid ColumnDefinitions="260,4,*" Background="{DynamicResource BackgroundBrush}">
        <views:WorkspaceTreeView Grid.Column="0" DataContext="{Binding}" />
        <GridSplitter Grid.Column="1" Classes="pane" ResizeDirection="Columns" />
        <views:WorkspaceEditorView Grid.Column="2" DataContext="{Binding}" />
    </Grid>
</UserControl>
