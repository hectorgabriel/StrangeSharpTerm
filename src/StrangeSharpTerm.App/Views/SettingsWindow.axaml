<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
        xmlns:views="clr-namespace:StrangeSharpTerm.App.Views"
        x:Class="StrangeSharpTerm.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="560" Height="560" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <!--
        Appearance, the assistant, and the libraries. Connected tools is the
        section still to come, with M7; an empty one now would only promise
        something that is not there.

        The assistant's two context switches live here rather than in a pane
        because each of them is a choice about what leaves the machine, and a
        choice like that belongs somewhere a person can find it.
    -->
    <Window.Resources>
        <!-- Declared here rather than on the application, as every other view
             that draws an icon does: a view that resolves its converter from
             Application.Current cannot be built without one, and the plain unit
             tests build these controls with no application at all. -->
        <views:IconConverter x:Key="Icon" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="APPEARANCE" />

                <ItemsControl ItemsSource="{Binding Themes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeChoice">
                            <!-- The whole card is the target: a theme is picked by
                                 pointing at the one that looks right. -->
                            <Button Classes="card" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,8" Padding="10" BorderBrush="{Binding Outline}"
                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ChooseCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Four of its own colours, in the order they
                                         stack up on screen. -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2"
                                                VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border Width="14" Height="34" CornerRadius="3,0,0,3" Background="{Binding Rail}" />
                                        <Border Width="14" Height="34" Background="{Binding Sidebar}" />
                                        <Border Width="14" Height="34" Background="{Binding Background}" />
                                        <Border Width="14" Height="34" CornerRadius="0,3,3,0" Background="{Binding Accent}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding Description}" />
                                    </StackPanel>

                                    <Path Grid.Column="2" Classes="icon" Width="18" Height="18"
                                          VerticalAlignment="Center" IsVisible="{Binding IsChosen}"
                                          Stroke="{DynamicResource AccentBrush}"
                                          Data="{Binding Source=IconCircleCheck, Converter={StaticResource Icon}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="{x:Static vm:SettingsViewModel.ThemeNote}" />

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14" />

                <TextBlock Classes="section" Text="ASSISTANT" />

                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderChoice">
                            <Button Classes="card" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,6" Padding="10"
                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ChooseProviderCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <!-- Which country the terminal output is going to is
                                             part of choosing one, not a footnote. -->
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding DataGoesTo}" />
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding KeyNote}" />
                                    </StackPanel>
                                    <Path Grid.Column="1" Classes="icon" Width="18" Height="18"
                                          VerticalAlignment="Center" IsVisible="{Binding IsChosen}"
                                          Stroke="{DynamicResource AccentBrush}"
                                          Data="{Binding Source=IconCircleCheck, Converter={StaticResource Icon}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Free text with the known ones offered: model names change
                     faster than this app ships. -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <AutoCompleteBox Grid.Column="1" Text="{Binding Model}"
                                     Watermark="{Binding DefaultModel}"
                                     FilterMode="Contains" MinimumPrefixLength="0"
                                     ItemsSource="{Binding KnownModels}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" Text="API key" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" PasswordChar="•" Text="{Binding NewKey}"
                             Watermark="Paste a key to save it" />
                    <Button Grid.Column="2" Padding="10,4" Margin="8,0,0,0" Command="{Binding SaveKeyCommand}">
                        <TextBlock Text="Save" FontSize="12" />
                    </Button>
                    <Button Grid.Column="3" Padding="10,4" Margin="6,0,0,0" Command="{Binding ForgetKeyCommand}">
                        <TextBlock Text="Forget" FontSize="12" />
                    </Button>
                </Grid>

                <TextBlock Classes="danger" FontSize="11" TextWrapping="Wrap" Text="{Binding KeyFailure}"
                           IsVisible="{Binding KeyFailure, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{x:Static vm:SettingsViewModel.ContextNote}" />

                <CheckBox IsChecked="{Binding SendMetrics}">
                    <TextBlock Text="Send the host's current metrics" FontSize="12" />
                </CheckBox>
                <CheckBox IsChecked="{Binding SendTerminalTail}" Margin="0,-6,0,0">
                    <TextBlock Text="Send what the terminal is showing, with secrets removed" FontSize="12" />
                </CheckBox>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14" />

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="section" Text="CONNECTED TOOLS"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="row" Padding="10,3" Command="{Binding AddServerCommand}">
                        <TextBlock Text="+  Add server" FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Button>
                </Grid>

                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !HasServers}"
                           Text="An assistant that can only reach the machine in front of it cannot answer &quot;is this ours or the upstream's?&quot; — that is usually in a dashboard, a tracker or somebody's runbook." />

                <ItemsControl ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerRow">
                            <Border Classes="chip" Padding="12,10" CornerRadius="6" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <!-- Connected or not, said by a dot before the name,
                                         as the tunnels pane says it about a forward. -->
                                    <Ellipse Grid.Row="0" Grid.Column="0" Width="8" Height="8"
                                             Margin="0,0,10,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource MutedBrush}" IsVisible="{Binding !IsConnected}" />
                                    <Ellipse Grid.Row="0" Grid.Column="0" Width="8" Height="8"
                                             Margin="0,0,10,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsConnected}" />

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="muted" FontSize="11"
                                               Text="{Binding Summary}" />

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted"
                                               FontFamily="monospace" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,2,0,0" Text="{Binding Where}" />

                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="danger"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{Binding Failure}" IsVisible="{Binding HasFailed}" />

                                    <!-- What has been granted, shown rather than hidden, and
                                         takeable back. -->
                                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Classes="warning"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{Binding Granted}" IsVisible="{Binding HasGrants}" />

                                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                        <Button Padding="10,3"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).EditServerCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Edit" FontSize="11" />
                                        </Button>
                                        <Button Padding="10,3" IsVisible="{Binding CanSignIn}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SignInCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Sign in" FontSize="11" />
                                        </Button>
                                        <Button Padding="10,3" IsVisible="{Binding HasGrants}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RevokeGrantsCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Ask me again" FontSize="11" />
                                        </Button>
                                        <Button Padding="10,3"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveServerCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Remove" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="danger" FontSize="11" TextWrapping="Wrap" Text="{Binding ToolFailure}"
                           IsVisible="{Binding ToolFailure, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <CheckBox IsChecked="{Binding OfferInPanes}" Margin="0,4,0,0">
                    <TextBlock Text="Offer tools in assistant panes" FontSize="12" />
                </CheckBox>
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="24,-6,0,0"
                           Text="Each call still stops for approval unless you have marked that tool as always allowed." />

                <CheckBox IsChecked="{Binding OfferInRuns}">
                    <TextBlock Text="Offer tools in orchestrated runs" FontSize="12" />
                </CheckBox>
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="24,-6,0,0"
                           Text="Off by default. In a run every host gets the same tools pointed at the same place, so one instruction can become one write per host — and the approvals arrive as a queue." />

                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{x:Static vm:SettingsViewModel.ToolsNote}" />

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14" />

                <TextBlock Classes="section" Text="LIBRARIES" />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="Described once and pointed at from anywhere: a key or password a host authenticates with, and a command worth keeping." />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Padding="12,6" Command="{Binding OpenCredentialsCommand}">
                        <TextBlock Text="Credentials…" />
                    </Button>
                    <Button Padding="12,6" Command="{Binding OpenSnippetsCommand}">
                        <TextBlock Text="Snippets…" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0"
                Theme="{StaticResource PrimaryButton}" Padding="14,6" IsDefault="True" Click="Done">
            <TextBlock Text="Done" />
        </Button>
    </Grid>
</Window>
