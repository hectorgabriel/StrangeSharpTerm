<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
        x:Class="StrangeSharpTerm.App.Views.CredentialEditor"
        x:DataType="vm:CredentialDraft"
        Title="{Binding Title}"
        Width="520" Height="420" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1" Spacing="10">
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" Text="Name" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameField"
                         Text="{Binding Name, Mode=TwoWay}" Watermark="Production key" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" Text="Method" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Static vm:CredentialDraft.Methods}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding Method, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Label}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="muted" Text="Username" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Username, Mode=TwoWay}"
                         Watermark="Used by hosts that name none" />

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="muted" Text="Key file"
                           VerticalAlignment="Center" IsVisible="{Binding WantsIdentityFile}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IdentityFile, Mode=TwoWay}"
                         IsVisible="{Binding WantsIdentityFile}" Watermark="~/.ssh/id_ed25519" />
            </Grid>

            <!-- The secret is written, never read back: a field that showed it
                 would be a field that leaks it to a screenshot. -->
            <StackPanel Spacing="6" IsVisible="{Binding WantsSecret}" Margin="0,6,0,0">
                <TextBlock Classes="section" Text="{Binding SecretLabel}" />
                <TextBox PasswordChar="•" Text="{Binding Secret, Mode=TwoWay}" />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding SecretNote}" />
                <CheckBox IsChecked="{Binding ForgetSecret, Mode=TwoWay}" IsVisible="{Binding HadSecret}">
                    <TextBlock Text="Forget the stored one" FontSize="12" />
                </CheckBox>
            </StackPanel>

            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !WantsSecret}"
                       Text="{Binding SecretNote}" />
        </StackPanel>

        <Border Grid.Row="2" Classes="banner" Margin="0,12,0,0" x:Name="Problems" IsVisible="False">
            <TextBlock Text="{Binding ProblemSummary}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Click="Cancel" />
            <Button Theme="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" Padding="14,6" Click="Save" />
        </StackPanel>
    </Grid>
</Window>
