<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
             xmlns:views="clr-namespace:StrangeSharpTerm.App.Views"
             xmlns:assist="clr-namespace:StrangeSharpTerm.Assist;assembly=StrangeSharpTerm.Assist"
             x:Class="StrangeSharpTerm.App.Views.AssistantView"
             x:DataType="vm:AssistantViewModel">
    <!--
        A conversation about one host, beside the terminal it is about.

        Two things here are the design rather than the layout. A suggested
        command is typed into the terminal and not run, so its button says so.
        And a command the model wants to run itself is a row in this same list
        with its reason under it: what it actually ran should never require
        looking somewhere else.
    -->
    <UserControl.Resources>
        <views:IconConverter x:Key="Icon" />
        <views:IllustrationConverter x:Key="Illustration" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Background="{DynamicResource BackgroundBrush}">

        <!-- Who is answering, named here because it decides where this
             conversation's terminal output is being sent. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="12,10,10,8">
            <Image Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Source="{Binding Source=chat-bubble, Converter={StaticResource Illustration}}" />
            <TextBlock Grid.Column="1" Text="Assistant" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding ShowsAlias}" Text="{Binding Alias}" />

            <CheckBox Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center"
                      IsChecked="{Binding MayRunCommands}">
                <TextBlock Text="Run commands" FontSize="12" />
            </CheckBox>

            <!-- Only where a folder is open. A switch for something that cannot
                 happen is a switch that teaches people switches do nothing. -->
            <CheckBox Grid.Column="4" Margin="0,0,10,0" VerticalAlignment="Center"
                      IsVisible="{Binding HasWorkspace}"
                      ToolTip.Tip="{Binding WorkspaceRoot}"
                      IsChecked="{Binding MayEditFiles}">
                <TextBlock Text="Edit files" FontSize="12" />
            </CheckBox>

            <TextBlock Grid.Column="5" Classes="muted" FontSize="11" VerticalAlignment="Center"
                       Text="{Binding Answering}" />
        </Grid>

        <!-- Follows the answer as it streams, and lets go as soon as you
             scroll up to read something further back. -->
        <ScrollViewer Grid.Row="1" views:Follows.TheEnd="True">
            <StackPanel Margin="12,0,12,8" Spacing="10">

                <StackPanel Margin="0,8" Spacing="10" IsVisible="{Binding IsEmpty}">
                    <Image Width="64" Height="64" Source="{Binding Source=chat-bubble, Converter={StaticResource Illustration}}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Ask about this host. The question carries its name, what uname reported, the metrics a probe collects now, and the tail of the terminal beside this pane — secrets removed. Nothing is run unless you turn on Run commands, and even then anything that writes stops to ask you." />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssistRow">
                            <StackPanel Margin="0,0,0,8">

                                <!-- What was asked. -->
                                <StackPanel IsVisible="{Binding IsQuestion}" Spacing="4">
                                    <TextBlock Classes="section" Text="YOU" />
                                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- What came back: prose and fenced blocks, each drawn as
                                     what it is. Rendering the markdown raw would put the
                                     fence characters on screen, and a code block would read
                                     as part of the sentence above it. -->
                                <StackPanel IsVisible="{Binding IsAnswer}" Spacing="6">
                                    <!-- Reasoning stays once the answer arrives, folded. It
                                         used to vanish the moment the first token landed,
                                         which made it a spinner rather than something to
                                         read. -->
                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Left" IsVisible="{Binding HasReasoning}"
                                            Command="{Binding ToggleReasoningCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="muted" FontSize="10" Text="THINKING" />
                                            <TextBlock Classes="muted" FontSize="10"
                                                       Text="{Binding ReasoningToggle}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Classes="muted" FontSize="11" FontStyle="Italic"
                                               TextWrapping="Wrap" IsVisible="{Binding ShowsReasoning}"
                                               Text="{Binding Reasoning}" />

                                    <!-- The answer, with its bold, its lists and its
                                         fenced blocks drawn as what they are. Every
                                         block can be copied; only one the model
                                         tagged as shell gets the button that types
                                         it into the terminal. -->
                                    <views:MarkdownView
                                        Text="{Binding Text}"
                                        StageCommand="{Binding $parent[UserControl].((vm:AssistantViewModel)DataContext).StageCommand}" />

                                    <!-- Copy takes the answer as it was written,
                                         Markdown and all, because that is what
                                         goes into a ticket. Retry takes the
                                         question back and asks it again. -->
                                    <StackPanel Classes="answered" Orientation="Horizontal" Spacing="4"
                                                HorizontalAlignment="Right" Margin="0,2,0,0">
                                        <Button Classes="row" Padding="8,2"
                                                Command="{Binding $parent[UserControl].((vm:AssistantViewModel)DataContext).CopyAnswerCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Copy" FontSize="11" />
                                        </Button>
                                        <Button Classes="row" Padding="8,2"
                                                Command="{Binding $parent[UserControl].((vm:AssistantViewModel)DataContext).RetryCommand}">
                                            <TextBlock Text="Retry" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- A command, in the same list as the answer. -->
                                <Border Classes="chip" Padding="12,9" CornerRadius="6" IsVisible="{Binding IsStep}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <SelectableTextBlock Grid.Row="0" Grid.Column="0" FontFamily="monospace" FontSize="12"
                                                   TextWrapping="Wrap" Text="{Binding Command}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="muted" FontSize="11"
                                                   Margin="10,0,0,0" VerticalAlignment="Top" Text="{Binding State}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" FontSize="11"
                                                   Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding Why}" />

                                        <!-- Why a person is being asked, and the two answers. -->
                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6" Margin="0,8,0,0"
                                                    IsVisible="{Binding IsWaiting}">
                                            <TextBlock Classes="warning" FontSize="11" TextWrapping="Wrap"
                                                       Text="{Binding Gate}" IsVisible="{Binding !IsDestructive}" />
                                            <TextBlock Classes="danger" FontSize="11" TextWrapping="Wrap"
                                                       Text="{Binding Gate}" IsVisible="{Binding IsDestructive}" />

                                            <!-- What a write would actually do. In the bar itself,
                                                 because approving a change you have not read is
                                                 approving a file you have not read. -->
                                            <Border Padding="8" CornerRadius="4" IsVisible="{Binding HasDetail}"
                                                    Background="{DynamicResource BackgroundBrush}">
                                                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
                                                    <SelectableTextBlock FontFamily="monospace" FontSize="11"
                                                               Text="{Binding Detail}" />
                                                </ScrollViewer>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Padding="12,4"
                                                        Command="{Binding $parent[UserControl].((vm:AssistantViewModel)DataContext).AllowCommand}">
                                                    <TextBlock Text="{Binding AllowLabel}" FontSize="12" />
                                                </Button>
                                                <Button Padding="12,4"
                                                        Command="{Binding $parent[UserControl].((vm:AssistantViewModel)DataContext).RefuseCommand}">
                                                    <TextBlock Text="No" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                                Padding="8" CornerRadius="4" IsVisible="{Binding HasOutput}"
                                                Background="{DynamicResource BackgroundBrush}">
                                            <SelectableTextBlock FontFamily="monospace" FontSize="11" TextWrapping="Wrap"
                                                       Text="{Binding Output}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                           IsVisible="{Binding IsNote}" Text="{Binding Text}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- What gets sent. The preview is the request itself, not a description
             of it, so it cannot drift from what is actually carried. -->
        <!-- A connected tool's call, waiting on a person. The server, the tool,
             where it goes and the exact arguments are all here rather than
             behind a disclosure: a gate whose substance is one click away is a
             gate people approve without reading. -->
        <Border Grid.Row="2" Classes="banner" Margin="12,0,12,8" Padding="12,10"
                DataContext="{Binding WaitingTool}"
                IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  x:DataType="assist:PendingToolCall">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Server}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding Tool}" FontFamily="monospace" FontSize="12" />
                    <!-- The server's own claim. Shown, and never acted on. -->
                    <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center"
                               Text="the server calls this read-only" IsVisible="{Binding ReadOnlyClaim}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Classes="muted" FontSize="11" Margin="0,2,0,0"
                           Text="{Binding Destination, StringFormat='Its arguments go to {0}'}" />

                <Border Grid.Row="2" Margin="0,6,0,0" Padding="8" CornerRadius="4"
                        Background="{DynamicResource BackgroundBrush}">
                    <ScrollViewer MaxHeight="160">
                        <TextBlock FontFamily="monospace" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding Arguments}" />
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Padding="12,4"
                            Command="{Binding $parent[UserControl].((vm:AssistantViewModel)DataContext).AllowCommand}">
                        <TextBlock Text="Run it" FontSize="12" />
                    </Button>
                    <Button Padding="12,4"
                            Command="{Binding $parent[UserControl].((vm:AssistantViewModel)DataContext).RefuseCommand}">
                        <TextBlock Text="No" FontSize="12" />
                    </Button>
                    <!-- The only way a standing pass is ever granted, and never
                         offered for a tool the server calls destructive. -->
                    <Button Padding="12,4" IsVisible="{Binding MayBeGranted}"
                            Command="{Binding $parent[UserControl].((vm:AssistantViewModel)DataContext).AlwaysAllowCommand}">
                        <TextBlock Text="Always allow" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Expander Grid.Row="3" Margin="12,0,12,6" Padding="0" IsExpanded="False"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="What gets sent" FontSize="12" />
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding RedactionNote}" />
                </StackPanel>
            </Expander.Header>
            <ScrollViewer MaxHeight="220">
                <TextBlock FontFamily="monospace" FontSize="11" TextWrapping="Wrap"
                           Margin="4,6" Text="{Binding Preview}" />
            </ScrollViewer>
        </Expander>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="12,0,12,12">
            <!-- Grows with what is typed, up to a point, then scrolls. A
                 question about a server is sometimes a paragraph and an error
                 pasted under it, and a field one line tall says it should not
                 be. -->
            <TextBox Grid.Column="0" Watermark="Ask about this host…"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="32" MaxHeight="160" VerticalContentAlignment="Center"
                     Text="{Binding Question}" KeyDown="Typed" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6"
                    Theme="{StaticResource PrimaryButton}"
                    IsVisible="{Binding !IsAsking}" Command="{Binding AskCommand}">
                <TextBlock Text="Ask" />
            </Button>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6"
                    IsVisible="{Binding IsAsking}" Command="{Binding StopCommand}">
                <TextBlock Text="Stop" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
