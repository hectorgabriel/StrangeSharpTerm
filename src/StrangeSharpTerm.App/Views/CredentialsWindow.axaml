<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
        xmlns:views="clr-namespace:StrangeSharpTerm.App.Views"
        x:Class="StrangeSharpTerm.App.Views.CredentialsWindow"
        x:DataType="vm:CredentialsViewModel"
        Title="Credentials"
        Width="560" Height="480" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <views:IllustrationConverter x:Key="Illustration" />
    </Window.Resources>

    <!--
        A key or a password described once and pointed at from any number of
        hosts. Nothing here holds a secret: the list says whether the operating
        system's store has one, which is the only thing about it worth showing.
    -->
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Credentials" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Border Grid.Row="1" Classes="chip" Padding="0" CornerRadius="6">
            <ListBox Background="Transparent" ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CredentialRow">
                        <StackPanel Spacing="2" Margin="4,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Classes="chip" Padding="6,1">
                                    <TextBlock Classes="muted" FontSize="10" Text="{Binding Method}" />
                                </Border>
                            </StackPanel>
                            <!-- An agent credential has nothing to say here, and an
                                 empty line still takes up a line. -->
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}"
                                       IsVisible="{Binding HasDetail}" />
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding Usage}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="1" Margin="24" Spacing="12" VerticalAlignment="Center"
                    IsVisible="{Binding IsEmpty}">
            <Image Width="64" Height="64" HorizontalAlignment="Center" Source="{Binding Source=key, Converter={StaticResource Illustration}}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                       Text="No credentials yet. One describes a key or a password once, and any number of hosts can point at it — including a folder, which covers everything beneath it." />
        </StackPanel>

        <Border Grid.Row="2" Classes="banner" Margin="0,10,0,0"
                IsVisible="{Binding Failure, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Failure}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Padding="12,6" Margin="0,0,6,0" Command="{Binding AddCommand}">
                <TextBlock Text="Add…" />
            </Button>
            <Button Grid.Column="1" Padding="12,6" Margin="0,0,6,0" Command="{Binding EditCommand}">
                <TextBlock Text="Edit…" />
            </Button>
            <Button Grid.Column="2" Padding="12,6" Command="{Binding DeleteCommand}">
                <TextBlock Text="Delete…" />
            </Button>
            <Button Grid.Column="4" Theme="{StaticResource PrimaryButton}" Padding="14,6"
                    IsDefault="True" Click="Done">
                <TextBlock Text="Done" />
            </Button>
        </Grid>
    </Grid>
</Window>
