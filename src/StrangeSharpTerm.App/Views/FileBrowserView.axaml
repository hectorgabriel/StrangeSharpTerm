<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
             xmlns:views="clr-namespace:StrangeSharpTerm.App.Views"
             x:Class="StrangeSharpTerm.App.Views.FileBrowserView"
             x:DataType="vm:FileBrowserViewModel">
    <!--
        A directory on a server. A pane like a terminal is a pane: it belongs to
        one host, sits in a tab, and can be split beside a shell on the same
        machine — which is most of the reason to have it here rather than in a
        window of its own.
    -->
    <UserControl.Resources>
        <views:IconConverter x:Key="Icon" />
        <views:IllustrationConverter x:Key="Illustration" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource BackgroundBrush}">

        <!-- Where you are, and the ways out of it. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="8,8,8,4">
            <Button Grid.Column="0" Classes="row" Padding="6" ToolTip.Tip="Up one directory"
                    IsEnabled="{Binding CanGoUp}" Command="{Binding GoUpCommand}">
                <Path Classes="icon" Width="14" Height="14"
                      Data="{Binding Source=IconArrowUp, Converter={StaticResource Icon}}" />
            </Button>
            <Button Grid.Column="1" Classes="row" Padding="2" ToolTip.Tip="Home"
                    Command="{Binding GoHomeCommand}">
                <Image Width="22" Height="22"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       Source="{Binding Source=folder, Converter={StaticResource Illustration}}" />
            </Button>
            <Button Grid.Column="2" Classes="row" Padding="6" ToolTip.Tip="Read it again"
                    Command="{Binding RefreshCommand}">
                <Path Classes="icon" Width="14" Height="14"
                      Data="{Binding Source=IconRefreshCw, Converter={StaticResource Icon}}" />
            </Button>

            <TextBlock Grid.Column="3" Text="{Binding Path}" FontFamily="monospace"
                       VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="4" Classes="row" Padding="6" ToolTip.Tip="Upload into this directory"
                    Command="{Binding UploadCommand}">
                <Path Classes="icon" Width="14" Height="14"
                      Data="{Binding Source=IconUpload, Converter={StaticResource Icon}}" />
            </Button>
            <Button Grid.Column="5" Classes="row" Padding="6" ToolTip.Tip="Download to this Mac"
                    Command="{Binding DownloadCommand}">
                <Path Classes="icon" Width="14" Height="14"
                      Data="{Binding Source=IconDownload, Converter={StaticResource Icon}}" />
            </Button>
            <Button Grid.Column="6" Classes="row" Padding="2" ToolTip.Tip="Delete"
                    Command="{Binding DeleteCommand}">
                <Image Width="22" Height="22"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       Source="{Binding Source=trash-can, Converter={StaticResource Illustration}}" />
            </Button>
        </Grid>

        <!-- What went wrong, or what the last transfer did. -->
        <StackPanel Grid.Row="1" Margin="8,0,8,4">
            <Border Classes="banner" IsVisible="{Binding Failure, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding Failure}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Classes="muted" FontSize="11" Margin="2,2"
                       IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ListBox Grid.Row="2" Margin="4,0,4,4" Background="Transparent"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 KeyDown="Keyed">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FileRow">
                    <!-- Double click opens a directory, as it does everywhere else. -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="2"
                          DoubleTapped="Opened">
                        <!-- A picture where 3dicons has one, the line icon for a link. -->
                        <Panel Grid.Column="0" Width="18" Height="18" Margin="2,0,8,0">
                            <Path Classes="icon" Width="14" Height="14"
                                  Data="{Binding IconKey, Converter={StaticResource Icon}}" />
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Source="{Binding IconKey, Converter={StaticResource Illustration}}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Classes="muted" FontSize="11" Width="90"
                                   TextAlignment="Right" VerticalAlignment="Center" Text="{Binding Size}" />
                        <TextBlock Grid.Column="3" Classes="muted" FontSize="11" Margin="16,0,4,0"
                                   VerticalAlignment="Center" Text="{Binding Modified}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Classes="muted" Margin="24" VerticalAlignment="Top"
                   IsVisible="{Binding !Rows.Count}" Text="Nothing here." />

        <TextBlock Grid.Row="3" Classes="muted" FontSize="11" Margin="10,0,10,8"
                   IsVisible="{Binding IsBusy}" Text="Working…" />
    </Grid>
</UserControl>
