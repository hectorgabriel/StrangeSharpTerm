<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
        xmlns:views="clr-namespace:StrangeSharpTerm.App.Views"
        xmlns:transport="clr-namespace:StrangeSharpTerm.Transport;assembly=StrangeSharpTerm.Transport"
        x:Class="StrangeSharpTerm.App.Views.ShellWindow"
        x:DataType="vm:ShellViewModel"
        x:Name="Root"
        Title="StrangeSharpTerm" Width="1100" Height="700"
        MinWidth="720" MinHeight="420"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <views:IconConverter x:Key="Icon" />

        <!-- A bar and what it measures. Memory and disk are the same thing said
             about different numbers, so they are the same template. -->
        <DataTemplate x:Key="Gauge" x:DataType="vm:Gauge">
            <Grid ColumnDefinitions="60,*,Auto" IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Grid.Column="0" Classes="muted" FontSize="11" VerticalAlignment="Center"
                           Text="{Binding Label}" />
                <ProgressBar Grid.Column="1" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                             Minimum="0" Maximum="100" Value="{Binding Percent}"
                             Classes.warning="{Binding Pressure, Converter={x:Static views:PressureIs.Warning}}"
                             Classes.critical="{Binding Pressure, Converter={x:Static views:PressureIs.Critical}}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Text="{Binding Detail}" />
                    <TextBlock FontSize="11" VerticalAlignment="Center" Text="{Binding PercentText}" Width="34"
                               TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Panel>
    <Grid ColumnDefinitions="260,*">

        <!-- What you have, and what you are looking for. -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource SidebarBrush}">
            <!-- On macOS the traffic lights float over this corner, so the
                 header starts below them; on Windows the inset is nothing. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
                  Margin="{x:Static views:ShellWindow.HeaderMargin}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Hosts" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Classes="chip" VerticalAlignment="Center">
                        <TextBlock Classes="muted" Text="{Binding Inventory.ConnectionCount}" FontSize="11" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Classes="row" Padding="6" ToolTip.Tip="Add">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="New host…" Command="{Binding NewHostCommand}" />
                            <MenuItem Header="New folder…" Command="{Binding NewFolderCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <Path Classes="icon" Width="14" Height="14"
                          Data="{Binding Source=IconPlus, Converter={StaticResource Icon}}" />
                </Button>
            </Grid>

            <TextBox Grid.Row="1" Margin="12,0,12,8" PlaceholderText="Search"
                     Text="{Binding Inventory.Search, Mode=TwoWay}" />

            <ScrollViewer Grid.Row="2">
                <StackPanel Margin="8,0,8,12">
                    <ItemsControl ItemsSource="{Binding Inventory.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarRow">
                                <Button Classes="row" Classes.selected="{Binding IsSelected}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="6,4"
                                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).ActivateCommand}"
                                        CommandParameter="{Binding}">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Edit…"
                                                      Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).EditRowCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Delete…"
                                                      Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).DeleteRowCommand}"
                                                      CommandParameter="{Binding}" />
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Indent}">
                                        <Path Classes="icon" Width="12" Height="12" Opacity="0.6"
                                              Data="{Binding ChevronKey, Converter={StaticResource Icon}}" />
                                        <Path Classes="icon" Width="14" Height="14"
                                              Data="{Binding IconKey, Converter={StaticResource Icon}}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Classes="muted" Text="{Binding Hostname}" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- An empty inventory invites a host rather than inventing one. -->
                    <TextBlock Classes="muted" Margin="8,16" TextWrapping="Wrap" FontSize="12"
                               IsVisible="{Binding !Inventory.ConnectionCount}"
                               Text="No hosts yet. Import an ssh_config, or add one." />
                </StackPanel>
            </ScrollViewer>

            <!-- The theme moved into the settings sheet, which is what the foot of
                 the sidebar now opens. -->
            <Button Grid.Row="3" x:Name="SettingsButton" Classes="row" Margin="8,4,8,10"
                    HorizontalAlignment="Left" Padding="8,6"
                    Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="icon" Width="14" Height="14" Opacity="0.7" VerticalAlignment="Center"
                          Data="{Binding Source=IconSettings, Converter={StaticResource Icon}}" />
                    <TextBlock Classes="muted" FontSize="12" Text="Settings" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- The tabs, and whatever the focused one is showing. -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
            <!-- Windows has no system menu bar to put this in; macOS does, and
                 there this draws nothing. See docs/adr/0005. -->
            <NativeMenuBar Grid.Row="0" HorizontalAlignment="Left" Margin="4,2,0,0" />
            <!-- Splitting, closing and broadcasting act on the focused tab, so
                 they sit at the end of its strip rather than in the pane. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2"
                        HorizontalAlignment="Right" Margin="8,8,8,0"
                        IsVisible="{Binding Panes.Count}">
                <ToggleButton Classes="row" Padding="6" ToolTip.Tip="Type into every pane"
                              IsChecked="{Binding IsBroadcasting, Mode=TwoWay}"
                              IsEnabled="{Binding CanBroadcast}">
                    <Path Classes="icon" Width="14" Height="14"
                          Data="{Binding Source=IconRadioTower, Converter={StaticResource Icon}}" />
                </ToggleButton>
                <Button Classes="row" Padding="6" ToolTip.Tip="Split side by side"
                        Command="{Binding SplitRightCommand}">
                    <Path Classes="icon" Width="14" Height="14"
                          Data="{Binding Source=IconColumns2, Converter={StaticResource Icon}}" />
                </Button>
                <Button Classes="row" Padding="6" ToolTip.Tip="Split stacked"
                        Command="{Binding SplitDownCommand}">
                    <Path Classes="icon" Width="14" Height="14"
                          Data="{Binding Source=IconRows2, Converter={StaticResource Icon}}" />
                </Button>
                <Button Classes="row" Padding="6" ToolTip.Tip="Close this pane"
                        Command="{Binding ClosePaneCommand}">
                    <Path Classes="icon" Width="14" Height="14"
                          Data="{Binding Source=IconCircleX, Converter={StaticResource Icon}}" />
                </Button>
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}" Margin="8,8,8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TabItem">
                        <Border Classes="tab" Classes.active="{Binding IsActive}" Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="row" Padding="8,4"
                                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).FocusTabCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="12" Height="12"
                                              Data="{Binding Source=IconSquareTerminal, Converter={StaticResource Icon}}" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="row" Padding="4"
                                        Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}">
                                    <Path Classes="icon" Width="10" Height="10" Opacity="0.6"
                                          Data="{Binding Source=IconX, Converter={StaticResource Icon}}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A failed connection says why, where the user was looking. -->
            <Border Grid.Row="2" Classes="banner" Margin="8,8,8,0"
                    IsVisible="{Binding Failure, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Width="14" Height="14" Stroke="{DynamicResource DangerBrush}"
                          Data="{Binding Source=IconTriangleAlert, Converter={StaticResource Icon}}" />
                    <TextBlock Text="{Binding Failure}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <views:PaneSplitView Grid.Row="3" Margin="8"
                                 Panes="{Binding Panes}"
                                 Axis="{Binding Axis}"
                                 FocusCommand="{Binding FocusPaneCommand}" />

            <TextBlock Grid.Row="3" Classes="muted" Margin="24" TextWrapping="Wrap"
                       IsVisible="{Binding ShowsEmptyState}"
                       Text="Choose a host on the left." />

            <!-- With nothing open, the selected host explains itself: what a
                 connection would actually use, inheritance included. -->
            <ScrollViewer Grid.Row="3" Margin="24" Background="{DynamicResource BackgroundBrush}"
                          IsVisible="{Binding ShowsDetail}">
                <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Left">


                    <StackPanel Spacing="16" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Detail.Name}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Classes="muted" Text="{Binding Detail.UserAtHost}" FontFamily="monospace" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Detail.Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="chip" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding}" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Theme="{StaticResource PrimaryButton}" Command="{Binding ConnectSelectedCommand}" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="14" Height="14"
                                          Data="{Binding Source=IconSquareTerminal, Converter={StaticResource Icon}}" />
                                    <TextBlock Text="Open a shell" Foreground="{DynamicResource OnAccentBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding BrowseFilesCommand}" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="14" Height="14"
                                          Data="{Binding Source=IconFolderOpen, Converter={StaticResource Icon}}" />
                                    <TextBlock Text="Browse files" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenTunnelsCommand}" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="14" Height="14"
                                          Data="{Binding Source=IconArrowLeftRight, Converter={StaticResource Icon}}" />
                                    <TextBlock Text="Tunnels" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding EditSelectedCommand}" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="14" Height="14"
                                          Data="{Binding Source=IconSlidersHorizontal, Converter={StaticResource Icon}}" />
                                    <TextBlock Text="Edit" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteSelectedCommand}" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="14" Height="14"
                                          Data="{Binding Source=IconTrash2, Converter={StaticResource Icon}}" />
                                    <TextBlock Text="Delete" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- What the server says about itself, once someone asks.
                             Asked for rather than assumed: selecting a host does
                             not connect to it, and a dashboard that probed on
                             selection would undo that quietly. -->
                        <StackPanel Spacing="8" IsVisible="{Binding Detail.Dashboard,
                                    Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="section" Text="SERVER"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="muted" FontSize="11" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Detail.Dashboard.Uptime}" />
                                <Button Grid.Column="2" Classes="row" Padding="8,3"
                                        Command="{Binding Detail.Dashboard.RefreshCommand}">
                                    <TextBlock FontSize="11" Text="Check" />
                                </Button>
                            </Grid>

                            <Border Classes="chip" Padding="12,10" CornerRadius="6">
                                <StackPanel Spacing="10">
                                    <!-- Before the first answer, the card says what it is for. -->
                                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding !Detail.Dashboard.HasAnswer}"
                                               Text="Uptime, load, memory, disk and containers — one command, when you ask for it." />

                                    <TextBlock Classes="danger" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding Detail.Dashboard.Failure,
                                                           Converter={x:Static ObjectConverters.IsNotNull}}"
                                               Text="{Binding Detail.Dashboard.Failure}" />

                                    <TextBlock Classes="muted" FontSize="11"
                                               IsVisible="{Binding Detail.Dashboard.AnsweredWithNothing}"
                                               Text="The server answered, but has none of uptime, free or df." />

                                    <!-- Load, with the little of it this pane has seen. -->
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          IsVisible="{Binding Detail.Dashboard.Load,
                                                      Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Grid.Column="0" Classes="muted" FontSize="11"
                                                   Text="Load" VerticalAlignment="Center" Width="60" />
                                        <TextBlock Grid.Column="1" FontFamily="monospace" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Detail.Dashboard.Load}" />
                                        <views:Sparkline Grid.Column="2" Width="120" Height="22"
                                                         Stroke="{DynamicResource AccentBrush}"
                                                         Values="{Binding Detail.Dashboard.LoadHistory}" />
                                    </Grid>

                                    <ContentControl Content="{Binding Detail.Dashboard.Memory}"
                                                    ContentTemplate="{StaticResource Gauge}" />
                                    <ContentControl Content="{Binding Detail.Dashboard.Disk}"
                                                    ContentTemplate="{StaticResource Gauge}" />

                                    <ItemsControl ItemsSource="{Binding Detail.Dashboard.Containers}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="transport:ServerMetrics+Container">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                             Fill="{DynamicResource SuccessBrush}"
                                                             IsVisible="{Binding IsRunning}" />
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                             Fill="{DynamicResource MutedBrush}"
                                                             IsVisible="{Binding !IsRunning}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Classes="muted" FontSize="11" Text="{Binding Status}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Classes="section" Text="CONNECTION" Margin="0,6,0,0" />

                        <ItemsControl ItemsSource="{Binding Detail.Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DetailField">
                                    <Grid ColumnDefinitions="140,*" Margin="0,3">
                                        <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                   Classes.warning="{Binding IsWarning}"
                                                   Classes.danger="{Binding IsDanger}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="section" Text="PORT FORWARDING" Margin="0,6,0,0"
                                   IsVisible="{Binding Detail.Forwards.Count}" />

                        <ItemsControl ItemsSource="{Binding Detail.Forwards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ForwardSummary">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                        <TextBlock Classes="muted" Text="{Binding Flag}" FontFamily="monospace" />
                                        <TextBlock Text="{Binding Specification}" FontFamily="monospace" />
                                        <TextBlock Classes="warning" Text="needs root" FontSize="11"
                                                   IsVisible="{Binding NeedsRoot}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- Type a few letters, get the thing you meant. Over the window rather
         than in it: it is asked for from anywhere and belongs to no pane. -->
    <Border IsVisible="{Binding Palette.IsOpen}" Background="#66000000">
        <Border Classes="palette" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,120,0,0" Width="520">
            <StackPanel>
                <TextBox x:Name="PaletteQuery" Margin="10" PlaceholderText="What would you like to do?"
                         Text="{Binding Palette.Query, Mode=TwoWay}" />

                <ListBox Margin="4,0,4,8" MaxHeight="320" Background="Transparent"
                         ItemsSource="{Binding Palette.Matches}"
                         SelectedIndex="{Binding Palette.SelectedIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppCommand">
                            <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="muted" FontSize="11"
                                           Text="{Binding Shortcut}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Classes="muted" Margin="14,0,14,10" FontSize="11"
                           IsVisible="{Binding !Palette.Matches.Count}"
                           Text="Nothing matches." />
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</Window>
