<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
        xmlns:views="clr-namespace:StrangeSharpTerm.App.Views"
        x:Class="StrangeSharpTerm.App.Views.ShellWindow"
        x:DataType="vm:ShellViewModel"
        x:Name="Root"
        Title="StrangeSharpTerm" Width="1100" Height="700"
        MinWidth="720" MinHeight="420">

    <Window.Resources>
        <views:IconConverter x:Key="Icon" />
    </Window.Resources>

    <Grid ColumnDefinitions="260,*">

        <!-- What you have, and what you are looking for. -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,12,10,8" Spacing="8">
                <TextBlock Text="Hosts" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border CornerRadius="8" Padding="6,2" Background="#22808080" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Inventory.ConnectionCount}" FontSize="11" Opacity="0.7" />
                </Border>
            </StackPanel>

            <TextBox Grid.Row="1" Margin="12,0,12,8" PlaceholderText="Search"
                     Text="{Binding Inventory.Search, Mode=TwoWay}" />

            <ScrollViewer Grid.Row="2">
                <StackPanel Margin="8,0,8,12">
                    <ItemsControl ItemsSource="{Binding Inventory.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarRow">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="6,4" Background="Transparent" BorderThickness="0"
                                        Command="{Binding #Root.((vm:ShellViewModel)DataContext).ActivateCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Indent}">
                                        <Path Classes="icon" Width="12" Height="12" Opacity="0.6"
                                              Data="{Binding ChevronKey, Converter={StaticResource Icon}}" />
                                        <Path Classes="icon" Width="14" Height="14"
                                              Data="{Binding IconKey, Converter={StaticResource Icon}}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Hostname}" FontSize="11" Opacity="0.45"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- An empty inventory invites a host rather than inventing one. -->
                    <TextBlock Margin="8,16" TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                               IsVisible="{Binding !Inventory.ConnectionCount}"
                               Text="No hosts yet. Import an ssh_config, or add one." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The tabs, and whatever the focused one is showing. -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
            <ItemsControl Grid.Row="0" ItemsSource="{Binding Tabs}" Margin="8,8,8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TabItem">
                        <Border CornerRadius="6" Padding="2" Background="{Binding IsActive,
                                Converter={x:Static views:ActiveTabBrush.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Padding="8,4" Background="Transparent" BorderThickness="0"
                                        Command="{Binding #Root.((vm:ShellViewModel)DataContext).FocusTabCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="12" Height="12"
                                              Data="{Binding Source=IconSquareTerminal, Converter={StaticResource Icon}}" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="4" Background="Transparent" BorderThickness="0"
                                        Command="{Binding #Root.((vm:ShellViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}">
                                    <Path Classes="icon" Width="10" Height="10" Opacity="0.6"
                                          Data="{Binding Source=IconX, Converter={StaticResource Icon}}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A failed connection says why, where the user was looking. -->
            <Border Grid.Row="1" Margin="8,8,8,0" Padding="10,8" CornerRadius="6" Background="#33FF5555"
                    IsVisible="{Binding Failure, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Width="14" Height="14"
                          Data="{Binding Source=IconTriangleAlert, Converter={StaticResource Icon}}" />
                    <TextBlock Text="{Binding Failure}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="2" Margin="8" Content="{Binding PaneContent}" />

            <TextBlock Grid.Row="2" Margin="24" Opacity="0.5" TextWrapping="Wrap"
                       IsVisible="{Binding PaneContent, Converter={x:Static ObjectConverters.IsNull}}"
                       Text="Choose a host on the left to open a shell." />
        </Grid>
    </Grid>
</Window>
