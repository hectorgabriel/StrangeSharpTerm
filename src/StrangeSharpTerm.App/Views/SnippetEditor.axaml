<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
        x:Class="StrangeSharpTerm.App.Views.SnippetEditor"
        x:DataType="vm:SnippetDraft"
        Title="{Binding Title}"
        Width="560" Height="420" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1" Spacing="10">
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" Text="Name" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameField"
                         Text="{Binding Name, Mode=TwoWay}" Watermark="Tail the app log" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" Text="Offered" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Scopes}"
                          SelectedItem="{Binding Scope, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Label}" />
            </Grid>

            <StackPanel Spacing="6" Margin="0,4,0,0">
                <TextBlock Classes="section" Text="COMMAND" />
                <!-- Multi-line, because a saved command is often a pipeline and
                     wrapping it in a single-line field makes it unreadable. -->
                <TextBox Text="{Binding Command, Mode=TwoWay}" FontFamily="monospace"
                         AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"
                         Watermark="tail -f /var/log/{{service}}.log" />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding PlaceholderNote}" />
            </StackPanel>

            <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Classes="muted" Text="Tags" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Tags, Mode=TwoWay}" Watermark="logs, prod" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Classes="banner" Margin="0,12,0,0" x:Name="Problems" IsVisible="False">
            <TextBlock Text="{Binding ProblemSummary}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Click="Cancel" />
            <Button Theme="{StaticResource PrimaryButton}" Content="Save" Padding="14,6" Click="Save" />
        </StackPanel>
    </Grid>
</Window>
