<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
        xmlns:views="clr-namespace:StrangeSharpTerm.App.Views"
        x:Class="StrangeSharpTerm.App.Views.SnippetsWindow"
        x:DataType="vm:SnippetsViewModel"
        Title="Snippets"
        Width="620" Height="480" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <views:IllustrationConverter x:Key="Illustration" />
    </Window.Resources>

    <!--
        Commands worth keeping. One scoped to a folder is offered on the hosts
        beneath it and nowhere else; the palette is where they are run from.
    -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Snippets" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Border Grid.Row="1" Classes="chip" Padding="0" CornerRadius="6">
            <ListBox Background="Transparent" ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SnippetRow">
                        <StackPanel Spacing="2" Margin="4,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock FontFamily="monospace" FontSize="11" Text="{Binding Command}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="1" Margin="24" Spacing="12" VerticalAlignment="Center"
                    IsVisible="{Binding IsEmpty}">
            <Image Width="64" Height="64" HorizontalAlignment="Center" Source="{Binding Source=flash, Converter={StaticResource Illustration}}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                       Text="No snippets yet. A snippet is a command worth keeping — write {{name}} in it to be asked for a value each time it runs. Open one from the command palette." />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Padding="12,6" Margin="0,0,6,0" Command="{Binding AddCommand}">
                <TextBlock Text="Add…" />
            </Button>
            <Button Grid.Column="1" Padding="12,6" Margin="0,0,6,0" Command="{Binding EditCommand}">
                <TextBlock Text="Edit…" />
            </Button>
            <Button Grid.Column="2" Padding="12,6" Command="{Binding DeleteCommand}">
                <TextBlock Text="Delete…" />
            </Button>
            <Button Grid.Column="4" Theme="{StaticResource PrimaryButton}" Padding="14,6"
                    IsDefault="True" Click="Done">
                <TextBlock Text="Done" />
            </Button>
        </Grid>
    </Grid>
</Window>
