<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StrangeSharpTerm.App.ViewModels"
             xmlns:views="clr-namespace:StrangeSharpTerm.App.Views"
             x:Class="StrangeSharpTerm.App.Views.TunnelsView"
             x:DataType="vm:TunnelsViewModel">
    <!--
        A host's tunnels. What it defines comes from the inventory with folder
        inheritance applied — forwards accumulate down the tree rather than being
        replaced — and what is running is this pane's own business: closing it
        stops what it started, because a port left bound is worse than no tunnel.
    -->
    <UserControl.Resources>
        <views:IconConverter x:Key="Icon" />
        <views:IllustrationConverter x:Key="Illustration" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource BackgroundBrush}">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="12,10,10,6">
            <TextBlock Grid.Column="0" Classes="section" Text="TUNNELS" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="row" Padding="8,4" Margin="0,0,4,0"
                    Command="{Binding StartAutomaticCommand}">
                <TextBlock Text="Start the automatic ones" FontSize="12" />
            </Button>
            <Button Grid.Column="2" Classes="row" Padding="8,4"
                    IsEnabled="{Binding AnyRunning}" Command="{Binding StopAllCommand}">
                <TextBlock Text="Stop all" FontSize="12" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="8,0,8,8" Spacing="6">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TunnelRow">
                            <Border Classes="chip" Padding="12,10" CornerRadius="6" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <!-- Up or not, said by a dot before the name. -->
                                    <Ellipse Grid.Row="0" Grid.Column="0" Width="8" Height="8"
                                             Margin="0,0,10,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource MutedBrush}"
                                             IsVisible="{Binding !IsRunning}" />
                                    <Ellipse Grid.Row="0" Grid.Column="0" Width="8" Height="8"
                                             Margin="0,0,10,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource SuccessBrush}"
                                             IsVisible="{Binding IsRunning}" />

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Classes="muted" FontFamily="monospace" FontSize="11"
                                                   VerticalAlignment="Center" Text="{Binding Specification}" />
                                        <TextBlock Classes="warning" FontSize="11" VerticalAlignment="Center"
                                                   Text="needs root" IsVisible="{Binding NeedsRoot}" />
                                    </StackPanel>

                                    <Button Grid.Row="0" Grid.Column="2" Padding="12,4"
                                            Command="{Binding $parent[ItemsControl].((vm:TunnelsViewModel)DataContext).ToggleCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Action}" FontSize="12" />
                                    </Button>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" FontSize="11"
                                               Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Explanation}" />

                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="danger" FontSize="11"
                                               Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Failure}"
                                               IsVisible="{Binding Failure, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- No tunnels is the ordinary case, and says what one would be for. -->
                <StackPanel Margin="8,16" Spacing="10" IsVisible="{Binding IsEmpty}">
                    <Image Width="64" Height="64" HorizontalAlignment="Left" Source="{Binding Source=link, Converter={StaticResource Illustration}}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                               Text="This host has no port forwards. One would let you reach a database or a web server on it as though it were running here." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
