<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        The .NET JIT compiles managed code into memory and then runs it, which
        the hardened runtime forbids by default. Without both of these the app is
        signed, notarised, and killed by the kernel the moment it starts.

        These are hardened-runtime entitlements and need no provisioning profile
        - a different category from the File Provider and keychain-sharing
        entitlements that blocked the Swift app, which is why none of that
        recurs here. See docs/adr/0008.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!--
        The app reads ~/.ssh, known_hosts and an inventory the user points it at,
        and talks to arbitrary servers. It is deliberately unsandboxed: the Swift
        app was too, and the sandboxed halves of it were the extensions that have
        been dropped.
    -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
